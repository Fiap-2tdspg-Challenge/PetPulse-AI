# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# Sem ela o serviço funciona normalmente e os textos dos alertas usam o template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=20

# Chave compartilhada com a API Java (header X-API-Key). Vazia = sem autenticação (dev local).
AI_SERVICE_KEY=

# Arquivo SQLite onde o serviço guarda o histórico das análises (Lab 3.5)
PETPULSE_DB=petpulse_ai.db
